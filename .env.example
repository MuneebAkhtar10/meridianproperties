# Copy this file to .env and fill in real values. Never commit the real .env
# (it's already in .gitignore).

# ── Database (Supabase Postgres) ─────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ── Supabase Auth / Storage ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App URL (used to build links in emails) ──────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vercel Cron auth (service charge reminders) ──────────────────────────
CRON_SECRET=

# ── Email notifications (Resend) ─────────────────────────────────────────
# Sign up at https://resend.com, verify a sending domain, then set:
RESEND_API_KEY=
EMAIL_FROM="PropertyCare <notifications@yourdomain.com>"

# ── WhatsApp notifications + bot (Meta WhatsApp Cloud API) ───────────────
# Uses the WhatsApp number bought directly through Meta Business — not
# Twilio. All four values come from https://developers.facebook.com/apps
# under your app's "WhatsApp" product:
#
#   WHATSAPP_PHONE_NUMBER_ID
#     WhatsApp → API Setup (or Configuration) tab → "Phone number ID" —
#     a numeric ID, NOT the phone number itself.
#
#   WHATSAPP_ACCESS_TOKEN
#     The token shown on that same API Setup tab is temporary (24h) and
#     will silently break sending once it expires. For a permanent one:
#     Meta Business Suite (business.facebook.com) → Business Settings →
#     Users → System Users → create one → "Add Assets" and assign it your
#     WhatsApp app → "Generate New Token" → select the app and check
#     whatsapp_business_messaging (and whatsapp_business_management) →
#     generate. That long-lived token goes here.
#
#   WHATSAPP_APP_SECRET
#     developers.facebook.com/apps → your app → App Settings → Basic →
#     "App Secret" (click Show). Used to verify inbound webhook requests
#     really come from Meta.
#
#   WHATSAPP_VERIFY_TOKEN
#     Not issued by Meta — you make this up yourself (any random string).
#     You'll paste this same value into Meta's webhook setup screen
#     (WhatsApp → Configuration → Webhook → "Verify token") when you
#     register https://<your-domain>/api/whatsapp/webhook there; Meta
#     sends it back on the verification handshake and the app checks it
#     matches this value before confirming the webhook.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

#   WHATSAPP_TEMPLATE_TENANT_WELCOME
#     Name of the approved WhatsApp Message Template (WhatsApp Manager →
#     Message Templates, category "Utility") used for the tenant-assignment
#     notification — see notifyTenantAssigned in lib/notifications.ts. This
#     is very often the tenant's first-ever contact with the number, and
#     Meta blocks free-form text for that; a template is required instead.
#     Body should read something like:
#       "Hi there! You've been assigned to {{1}} at {{2}}. Your move-in
#        date is {{3}} and monthly rent is {{4}}. Welcome!"
#     ({{1}}=unit label, {{2}}=property name, {{3}}=move-in date,
#      {{4}}=monthly rent — matches the bodyParams order in the code.)
WHATSAPP_TEMPLATE_TENANT_WELCOME=

#   WHATSAPP_TEMPLATE_GENERIC
#     One approved template that covers EVERY OTHER cold-outreach
#     notification (HR document expiring, rent/service charge due, etc.) —
#     see lib/whatsapp.ts's sendWhatsApp. You do not need to make a new
#     template per notification type: free-form text is tried first, and
#     this template is only used automatically as a fallback when Meta
#     rejects a send for being outside the 24-hour customer service window.
#     Create it once in WhatsApp Manager → Message Templates: category
#     "Utility", body is exactly one variable and nothing else:
#       {{1}}
#     Sample value for review, e.g.: "Your rent payment of OMR 350 for
#     Apartment 204 is due on 5 October."
WHATSAPP_TEMPLATE_GENERIC=
