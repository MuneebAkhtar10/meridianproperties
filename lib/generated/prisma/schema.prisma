generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  user
  admin
  worker
  /// A landlord who can list their own properties (unapproved until an admin
  /// approves them) and see everything scoped to properties they own.
  owner
}

/// Only meaningful when userType = worker. Distinguishes staff employed by
/// the company (in_house) from external contractors/vendors (third_party).
enum WorkerCategory {
  in_house
  third_party
}

enum Priority {
  low
  medium
  high
}

enum RequestStatus {
  pending
  en_route
  in_progress
  on_hold
  completed
}

enum SupplyRequestStatus {
  pending
  approved
  denied
}

enum ChargeType {
  rent
  electricity
  gas
  water
  internet
  maintenance
  municipality_fee
  deposit
  other
}

enum ChargeStatus {
  open
  paid
  waived
}

enum PaymentStatus {
  pending
  approved
  rejected
}

enum PaymentMethod {
  cash
  bank_transfer
  oman_net
  mobile_payment
  direct_debit
  cheque
  other
}

enum TenancyPurpose {
  residential
  commercial
}

enum FinancialDocumentKind {
  bill
  receipt
}

enum EntityDocumentCategory {
  tenancy_agreement
  municipality_registration
  move_in_report
  title_deed
  ownership_certificate
  cadastral_plan
  building_permit
  completion_certificate
  noc
  property_insurance
  civil_id
  passport
  resident_card
  visa
  employment_letter
  driving_license
  vehicle_registration
  car_insurance
  other
}

/// A configurable kind of property (apartment building, villa, office, ...).
/// Admins can add their own instead of being limited to a fixed set, which is
/// why the floor behaviour and unit wording live here as data, not code.
model PropertyType {
  id               String   @id @default(uuid()) @db.Uuid
  /// Stable machine key, e.g. "apartment". Never shown to users.
  name             String   @unique
  /// Shown when picking a property type, e.g. "Apartment building".
  label            String
  /// Singular noun for one unit of this type, e.g. "Apartment", "Villa", "Office".
  unitNounSingular String   @map("unit_noun_singular")
  /// Plural noun, e.g. "Apartments", "Villas", "Offices".
  unitNounPlural   String   @map("unit_noun_plural")
  /// Short prefix shown before a unit's label, e.g. "Apt" → "Apt 101". Null
  /// means the unit label is shown on its own, with no prefix — the villa
  /// convention ("Villa 2", not "Villa Villa 2").
  unitPrefix       String?  @map("unit_prefix")
  /// Whether units of this type are organized by floor. Controls the floor
  /// field, the "generate by floor" wizard and the floor grouping in the UI.
  hasFloors        Boolean  @default(true) @map("has_floors")
  /// Whether units of this type track a bedroom count. Off for commercial
  /// types like offices or shops, where "bedrooms" doesn't apply.
  hasBedrooms      Boolean  @default(true) @map("has_bedrooms")
  /// Choices shown in "Where is the problem?" when a tenant of this type
  /// reports a maintenance issue, e.g. ["Kitchen", "Bathroom", ...] for an
  /// apartment or ["Sales floor", "Storeroom", ...] for a shop. Always ends
  /// with a fallback "Other" entry.
  locationOptions  String[] @default(["Main area", "Storeroom", "Entrance", "Whole space", "Other"]) @map("location_options")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  properties Property[]

  @@map("property_types")
}

/// A building or managed property in Oman.
model Property {
  id                          String    @id @default(uuid()) @db.Uuid
  name                        String
  propertyTypeId              String    @map("property_type_id") @db.Uuid
  address                     String
  governorate                 String?
  wilayat                     String?
  area                        String?
  wayNumber                   String?   @map("way_number")
  buildingNumber              String?   @map("building_number")
  postalCode                  String?   @map("postal_code")
  titleDeedNumber             String?   @map("title_deed_number")
  plotNumber                  String?   @map("plot_number")
  notes                       String?
  /// The landlord this property belongs to. Null means no owner is assigned
  /// yet (all properties created before the owner role existed, and any an
  /// admin hasn't assigned). Set automatically to themselves when an owner
  /// creates the property; only an admin can assign or reassign it.
  ownerId                     String?   @map("owner_id") @db.Uuid
  /// Live/visible to admin, tenant and worker screens once true. Properties
  /// an admin creates are approved immediately; properties an owner creates
  /// start unapproved and stay hidden everywhere until an admin approves
  /// them. Defaults to true so every pre-existing row stays live.
  approved                    Boolean   @default(true)
  /// When the owner submitted this property for admin review, after setting
  /// up its units. Null means it's still a draft — the owner is adding
  /// units and hasn't asked for approval yet, so it does NOT show up in the
  /// admin's pending-review queue even though approved is false. Only
  /// meaningful while approved is false; irrelevant once approved.
  submittedAt                 DateTime? @map("submitted_at")
  /// Recurring maintenance budget the owner collects from/for this property
  /// (e.g. 400 OMR every 3 months). All three are null until someone sets
  /// them; nulls mean "no service charge tracked" and the reminder job skips
  /// the property entirely.
  serviceChargeAmount         Decimal?  @map("service_charge_amount") @db.Decimal(14, 3)
  serviceChargeCycleMonths    Int?      @map("service_charge_cycle_months")
  serviceChargeDueDate        DateTime? @map("service_charge_due_date") @db.Date
  /// Which reminder was last sent for the CURRENT due date, so the daily job
  /// never sends the same stage twice ("upcoming" | "due" | "overdue").
  serviceChargeLastStage      String?   @map("service_charge_last_stage")
  /// When an admin last marked the service charge as received — shown as a
  /// confirmation tick on the property page. Cleared implicitly by simply
  /// being stale once a new due date has since passed.
  serviceChargeLastReceivedAt DateTime? @map("service_charge_last_received_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  propertyType       PropertyType         @relation(fields: [propertyTypeId], references: [id], onDelete: Restrict)
  owner              User?                @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  units              Unit[]
  documents          EntityDocument[]
  commonAreaRequests MaintenanceRequest[]

  @@index([propertyTypeId])
  @@index([ownerId])
  @@map("properties")
}

/// An apartment inside a building.
model Unit {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  label      String
  floor      Int?
  bedrooms   Int?
  /// The tenant living here. Null means the apartment is empty.
  tenantId   String?  @unique @map("tenant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property  Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant    User?                @relation("UnitTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  requests  MaintenanceRequest[]
  tenancies Tenancy[]
  charges   Charge[]

  @@unique([propertyId, label])
  @@index([propertyId])
  @@map("units")
}

/// Account and profile in one row. `userType` drives every authorization check.
/// `id` is not generated here — it is the id of the matching row in Supabase
/// Auth's `auth.users`, which credentials and password hashing live in; see
/// the `_supabase_auth` migration for the foreign key that ties the two together.
model User {
  id                          String          @id @db.Uuid
  /// Unique per role, not globally: a tenant and a worker (etc.) can share an
  /// email, but two tenants (or two workers) can't. See @@unique below.
  email                       String
  userType                    UserType        @default(user) @map("user_type")
  /// Only set when userType = worker: whether this worker is in-house staff
  /// or a 3rd-party contractor/vendor.
  workerCategory              WorkerCategory? @map("worker_category")
  /// Only meaningful for 3rd-party workers: the vendor/company name shown
  /// alongside their contact info wherever they're listed.
  companyName                 String?         @map("company_name")
  firstName                   String?         @map("first_name")
  lastName                    String?         @map("last_name")
  phone                       String?         @unique
  civilId                     String?         @unique @map("civil_id")
  nationality                 String?
  employer                    String?
  emergencyContactName        String?         @map("emergency_contact_name")
  emergencyContactPhone       String?         @map("emergency_contact_phone")
  /// The following are only meaningful for in-house workers — the paperwork
  /// required to legally employ someone in the Gulf. Third-party
  /// contractors' documents are their own employer's responsibility, not
  /// tracked here.
  passportNumber              String?         @map("passport_number")
  passportIssuance            DateTime?       @map("passport_issuance")
  passportExpiry              DateTime?       @map("passport_expiry")
  /// Work visa / residency permit.
  visaNumber                  String?         @map("visa_number")
  visaIssuance                DateTime?       @map("visa_issuance")
  visaExpiry                  DateTime?       @map("visa_expiry")
  /// Issuance/expiry of the Civil ID / Resident Card already captured in
  /// `civilId`.
  civilIdIssuance             DateTime?       @map("civil_id_issuance")
  civilIdExpiry               DateTime?       @map("civil_id_expiry")
  drivingLicenseNumber        String?         @map("driving_license_number")
  drivingLicenseIssuance      DateTime?       @map("driving_license_issuance")
  drivingLicenseExpiry        DateTime?       @map("driving_license_expiry")
  /// Only meaningful for in-house workers: "individual" (default) or
  /// "family" — a family employee's dependents (spouse/father/mother) get
  /// their own Bataka records tracked below via familyMembers.
  employeeType                String          @default("individual") @map("employee_type")
  /// Whether this worker has/drives a vehicle for work — gates whether the
  /// vehicle documents below are asked for at all.
  hasVehicle                  Boolean         @default(false) @map("has_vehicle")
  /// Mulkiya — vehicle registration.
  vehicleRegistrationNumber   String?         @map("vehicle_registration_number")
  vehicleRegistrationIssuance DateTime?       @map("vehicle_registration_issuance")
  vehicleRegistrationExpiry   DateTime?       @map("vehicle_registration_expiry")
  carInsuranceNumber          String?         @map("car_insurance_number")
  carInsuranceIssuance        DateTime?       @map("car_insurance_issuance")
  carInsuranceExpiry          DateTime?       @map("car_insurance_expiry")
  /// What was last sent for each HR document's expiry cycle — e.g.
  /// {"passport": "upcoming", "visa": "overdue:3"} — so the daily reminder
  /// job (lib/hr-reminders.ts) doesn't repeat the same nudge. Mirrors
  /// Property.serviceChargeLastStage's pattern, generalized to several
  /// documents per person instead of one charge per property.
  hrReminderStages            Json?           @map("hr_reminder_stages")
  createdAt                   DateTime        @default(now()) @map("created_at")
  updatedAt                   DateTime        @updatedAt @map("updated_at")

  /// Set only for tenants: the apartment they live in.
  unit                  Unit?                   @relation("UnitTenant")
  requests              MaintenanceRequest[]    @relation("RequestOwner")
  assignedRequests      MaintenanceRequest[]    @relation("AssignedWorker")
  createdRequests       MaintenanceRequest[]    @relation("RequestCreatedBy")
  attachments           MaintenanceAttachment[]
  taskLogs              TaskLog[]
  notifications         Notification[]
  tenancies             Tenancy[]               @relation("TenancyTenant")
  charges               Charge[]                @relation("ChargeTenant")
  createdCharges        Charge[]                @relation("ChargeCreator")
  submittedPayments     Payment[]               @relation("PaymentSubmitter")
  reviewedPayments      Payment[]               @relation("PaymentReviewer")
  financialUploads      FinancialAttachment[]   @relation("FinancialUploader")
  documents             EntityDocument[]        @relation("UserDocuments")
  documentUploads       EntityDocument[]        @relation("EntityDocumentUploader")
  supplyRequestsMade    SupplyRequest[]         @relation("SupplyRequestedBy")
  supplyRequestsDecided SupplyRequest[]         @relation("SupplyDecidedBy")
  /// Set only for owners: the properties they were assigned or created.
  ownedProperties       Property[]              @relation("PropertyOwner")
  whatsappSessions      WhatsappSession[]
  /// Rejections this admin issued (property, payment, or supply request).
  rejectionLogs         RejectionLog[]
  /// Only populated when employeeType = "family" — the worker's tracked
  /// dependents (see WorkerFamilyMember).
  familyMembers         WorkerFamilyMember[]

  @@unique([email, userType])
  @@map("users")
}

enum FamilyRelationship {
  spouse
  father
  mother
  child
}

/// A dependent (spouse/father/mother) tracked for an in-house worker whose
/// employeeType is "family" — mirrors the worker's own Bataka tracking, one
/// record per dependent. Limits (up to 4 spouses, 1 father, 1 mother) are
/// enforced in the server action, not here.
model WorkerFamilyMember {
  id               String             @id @default(uuid()) @db.Uuid
  workerId         String             @map("worker_id") @db.Uuid
  name             String
  relationship     FamilyRelationship
  civilIdIssuance  DateTime?          @map("civil_id_issuance")
  civilIdExpiry    DateTime?          @map("civil_id_expiry")
  documentFileName String?            @map("document_file_name")
  documentFilePath String?            @map("document_file_path")
  documentFileType String?            @map("document_file_type")
  documentFileSize Int?               @map("document_file_size")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  worker User @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_family_members")
}

/// A historical occupancy record. Unit.tenantId remains the fast pointer to the
/// current occupant; this model preserves the commercial terms and move history.
model Tenancy {
  id                         String         @id @default(uuid()) @db.Uuid
  unitId                     String         @map("unit_id") @db.Uuid
  tenantId                   String         @map("tenant_id") @db.Uuid
  startDate                  DateTime       @map("start_date") @db.Date
  endDate                    DateTime?      @map("end_date") @db.Date
  leaseEndDate               DateTime?      @map("lease_end_date") @db.Date
  monthlyRent                Decimal        @default(0) @map("monthly_rent") @db.Decimal(14, 3)
  rentDueDay                 Int            @default(5) @map("rent_due_day")
  securityDeposit            Decimal        @default(0) @map("security_deposit") @db.Decimal(14, 3)
  purpose                    TenancyPurpose @default(residential)
  agreementRef               String?        @map("agreement_ref")
  municipalityContractNumber String?        @map("municipality_contract_number")
  contractRegisteredAt       DateTime?      @map("contract_registered_at") @db.Date
  electricityAccountNumber   String?        @map("electricity_account_number")
  waterAccountNumber         String?        @map("water_account_number")
  notes                      String?
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  unit      Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant    User             @relation("TenancyTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  charges   Charge[]
  documents EntityDocument[]

  @@index([unitId, endDate])
  @@index([tenantId, endDate])
  @@map("tenancies")
}

/// Private supporting documents belonging to exactly one property, tenancy or person.
model EntityDocument {
  id           String                 @id @default(uuid()) @db.Uuid
  propertyId   String?                @map("property_id") @db.Uuid
  tenancyId    String?                @map("tenancy_id") @db.Uuid
  userId       String?                @map("user_id") @db.Uuid
  category     EntityDocumentCategory
  label        String?
  fileName     String                 @map("file_name")
  filePath     String                 @map("file_path")
  fileType     String                 @map("file_type")
  fileSize     Int                    @map("file_size")
  uploadedById String?                @map("uploaded_by") @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenancy    Tenancy?  @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  user       User?     @relation("UserDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("EntityDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([propertyId, createdAt])
  @@index([tenancyId, createdAt])
  @@index([userId, createdAt])
  @@map("entity_documents")
}

/// One amount due from a tenant. Approved payments can be partial; the charge is
/// closed only once their total reaches the amount due.
model Charge {
  id          String       @id @default(uuid()) @db.Uuid
  tenancyId   String       @map("tenancy_id") @db.Uuid
  unitId      String       @map("unit_id") @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  type        ChargeType
  title       String
  amount      Decimal      @db.Decimal(14, 3)
  dueDate     DateTime     @map("due_date") @db.Date
  periodStart DateTime?    @map("period_start") @db.Date
  status      ChargeStatus @default(open)
  notes       String?
  /// Set only for generated rent, making generation safely repeatable.
  rentKey     String?      @unique @map("rent_key")
  createdById String?      @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenancy     Tenancy               @relation(fields: [tenancyId], references: [id], onDelete: Cascade)
  unit        Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  tenant      User                  @relation("ChargeTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("ChargeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  payments    Payment[]
  attachments FinancialAttachment[]

  @@index([tenantId, status, dueDate])
  @@index([unitId, dueDate])
  @@index([tenancyId, periodStart])
  @@index([type])
  @@map("charges")
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  chargeId      String        @map("charge_id") @db.Uuid
  amount        Decimal       @db.Decimal(14, 3)
  paidAt        DateTime      @map("paid_at") @db.Date
  method        PaymentMethod
  reference     String?
  notes         String?
  status        PaymentStatus @default(pending)
  submittedById String        @map("submitted_by") @db.Uuid
  reviewedById  String?       @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime?     @map("reviewed_at")
  reviewNotes   String?       @map("review_notes")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  charge      Charge                @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  submittedBy User                  @relation("PaymentSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  reviewedBy  User?                 @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  attachments FinancialAttachment[]

  @@index([chargeId, status])
  @@index([status, createdAt])
  @@map("payments")
}

model FinancialAttachment {
  id           String                @id @default(uuid()) @db.Uuid
  chargeId     String?               @map("charge_id") @db.Uuid
  paymentId    String?               @map("payment_id") @db.Uuid
  kind         FinancialDocumentKind
  fileName     String                @map("file_name")
  filePath     String                @map("file_path")
  fileType     String                @map("file_type")
  fileSize     Int                   @map("file_size")
  uploadedById String?               @map("uploaded_by") @db.Uuid
  createdAt    DateTime              @default(now()) @map("created_at")

  charge     Charge?  @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  payment    Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("FinancialUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([chargeId])
  @@index([paymentId])
  @@map("financial_attachments")
}

model MaintenanceRequest {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  /// The apartment the issue is in. This is what tells anyone which flat in which
  /// building to actually go to. Null for a common-area request — one that
  /// belongs to the property as a whole (lobby, parking, garden) rather than
  /// a specific tenant's unit. Exactly one of unitId/propertyId is set.
  unitId            String?        @map("unit_id") @db.Uuid
  /// Set only for a common-area request (unitId null) — which property the
  /// shared space belongs to. Redundant with unit.propertyId otherwise, so
  /// left null when unitId is set rather than duplicating it.
  propertyId        String?        @map("property_id") @db.Uuid
  title             String
  description       String
  /// Room within the apartment (e.g. "Kitchen"), or the common area itself
  /// (e.g. "Lobby", "Parking") when unitId is null.
  location          String
  priority          Priority       @default(medium)
  status            RequestStatus  @default(pending)
  assignedToId      String?        @map("assigned_to") @db.Uuid
  /// Who actually filed this — set only when an admin creates it on a
  /// tenant's behalf (via the maintenance dashboard), so the UI can show
  /// "Added by <admin>" distinct from `user` (the tenant it's for). Left
  /// null for a tenant's own self-reported request; nothing to distinguish
  /// there since userId already is the reporter in that case.
  createdById       String?        @map("created_by_id") @db.Uuid
  notes             String?
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  completedAt       DateTime?      @map("completed_at")
  enRouteAt         DateTime?      @map("en_route_at")
  inProgressAt      DateTime?      @map("in_progress_at")
  /// A held job leaves the worker's active queue and waits for an admin decision.
  /// The old worker stays assigned as the default choice when work is resumed.
  holdReason        String?        @map("hold_reason")
  heldAt            DateTime?      @map("held_at")
  heldFromStatus    RequestStatus? @map("held_from_status")
  /// Set when the tenant tells management that their side of the blocker is clear.
  /// It is only a signal; an admin still chooses the worker and resumes the job.
  resumeRequestedAt DateTime?      @map("resume_requested_at")
  /// 4-digit code the tenant gives the worker to confirm completion. Set when the
  /// worker requests completion, cleared once the code is entered or cancelled.
  completionCode    String?        @map("completion_code")
  completionCodeAt  DateTime?      @map("completion_code_at")

  user             User                    @relation("RequestOwner", fields: [userId], references: [id], onDelete: Cascade)
  unit             Unit?                   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  property         Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  assignedTo       User?                   @relation("AssignedWorker", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy        User?                   @relation("RequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  attachments      MaintenanceAttachment[]
  taskLogs         TaskLog[]
  notifications    Notification[]
  supplyRequests   SupplyRequest[]
  whatsappSessions WhatsappSession[]

  @@index([userId])
  @@index([unitId])
  @@index([propertyId])
  @@index([assignedToId])
  @@index([status])
  @@map("maintenance_requests")
}

/// A worker's ask for something needed to finish a held job — a part, a
/// tool, a purchase. The admin approves (optionally with a note on where it
/// is / how it was sourced) or denies (with a reason); the worker resumes
/// the job themselves once they actually have it in hand.
model SupplyRequest {
  id              String              @id @default(uuid()) @db.Uuid
  requestId       String              @map("request_id") @db.Uuid
  /// Short name of what's needed, e.g. "20m PVC pipe" or "replacement water heater".
  item            String
  /// Extra detail from the worker — size, brand, where to buy, cost estimate.
  notes           String?
  status          SupplyRequestStatus @default(pending)
  /// Admin's reason for denying, or a note like "picked up, ready for you".
  adminNote       String?             @map("admin_note")
  /// The actual price paid, recorded by the admin at the moment of approval.
  /// Set once and never edited again — decideSupplyRequestAction refuses any
  /// request that isn't still pending, so this is the permanent cost record
  /// for the audit trail, unaffected by later job status changes.
  cost            Decimal?            @db.Decimal(14, 3)
  /// What the worker says they paid, entered alongside the receipt. A
  /// suggestion for the admin only — never authoritative and never a
  /// substitute for `cost`, which the admin sets explicitly on approval.
  workerCost      Decimal?            @map("worker_cost") @db.Decimal(14, 3)
  /// Storage object key for a photo/PDF of the purchase receipt the worker
  /// uploaded as proof of what they already bought. Set once, while the
  /// request is still pending — see uploadSupplyReceiptAction.
  receiptPath     String?             @map("receipt_path")
  receiptFileName String?             @map("receipt_file_name")
  receiptFileType String?             @map("receipt_file_type")
  requestedById   String              @map("requested_by") @db.Uuid
  decidedById     String?             @map("decided_by") @db.Uuid
  decidedAt       DateTime?           @map("decided_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  request     MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestedBy User               @relation("SupplyRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?              @relation("SupplyDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([status])
  @@map("supply_requests")
}

model MaintenanceAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  requestId   String   @map("request_id") @db.Uuid
  fileName    String   @map("file_name")
  /// Object key inside the MinIO bucket, e.g. "attachments/<requestId>/<uuid>.jpg".
  filePath    String   @map("file_path")
  fileType    String   @map("file_type")
  fileSize    Int      @map("file_size")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by") @db.Uuid

  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdBy User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("maintenance_attachments")
}

model TaskLog {
  id          String        @id @default(uuid()) @db.Uuid
  requestId   String        @map("request_id") @db.Uuid
  status      RequestStatus
  changedById String?       @map("changed_by") @db.Uuid
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User?              @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("task_logs")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String
  message   String
  relatedId String?  @map("related_to") @db.Uuid
  href      String?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  related MaintenanceRequest? @relation(fields: [relatedId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@map("notifications")
}

/// What an in-progress WhatsApp conversation with a given phone number is
/// currently doing — a tenant stepping through "report an issue", or a
/// worker who's been handed a specific task to act on. One row per phone
/// number; it's overwritten (not appended to) as the conversation moves
/// forward, since only the current step ever matters.
enum WhatsappFlow {
  /// Tenant is being walked through category → location → description →
  /// confirm to create a new maintenance request.
  new_request
  /// Worker has an assigned task in front of them and can reply to move it
  /// forward (start → in progress → request completion).
  worker_task
  /// Worker requested completion; the next message from them is treated as
  /// the 4-digit code the tenant gave them, not a new command.
  awaiting_completion_code
}

model WhatsappSession {
  id        String        @id @default(uuid()) @db.Uuid
  /// E.164 phone number — the WhatsApp conversation's identity. Looked up
  /// against User.phone on every inbound message.
  phone     String        @unique
  userId    String?       @map("user_id") @db.Uuid
  flow      WhatsappFlow?
  /// Free-form step name within the flow (e.g. "category", "location",
  /// "description", "confirm" for new_request). Not used by worker_task /
  /// awaiting_completion_code, which re-derive state from the live task.
  step      String?
  /// Answers collected so far in the current flow (category, location,
  /// description, ...). Cleared whenever the flow resets or completes.
  data      Json?
  /// The task a worker_task / awaiting_completion_code conversation is
  /// about.
  taskId    String?       @map("task_id") @db.Uuid
  updatedAt DateTime      @updatedAt @map("updated_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  task MaintenanceRequest? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("whatsapp_sessions")
}

/// What kind of thing was rejected. Payment and supply-request rejections
/// already keep their own permanent record on their own model (Payment.status
/// = rejected, SupplyRequest.status = denied) — this enum only needs to
/// name them so the admin rejections page can show one merged list.
/// Property rejection is the odd one out: rejectPropertyAction deletes the
/// property row outright, so RejectionLog is the ONLY surviving record of it.
enum RejectionKind {
  property
  payment
  supply_request
}

/// A permanent audit trail entry for a rejection, written at the moment of
/// rejection. Required for `property` (whose row is deleted right after), and
/// written for `payment`/`supply_request` too so the admin rejections page has
/// one single table to query instead of merging three different models.
model RejectionLog {
  id           String        @id @default(uuid()) @db.Uuid
  kind         RejectionKind
  /// Human-readable label for the rejected thing, e.g. the property name or
  /// the charge title — captured as text since the underlying row (property)
  /// may no longer exist.
  entityLabel  String        @map("entity_label")
  /// Who the rejection affects, e.g. "owner@x.com" or "tenant@x.com" —
  /// captured as text for the same reason as entityLabel.
  affectedUser String?       @map("affected_user")
  /// Amount involved, if any (payment rejections only).
  amount       Decimal?      @db.Decimal(14, 3)
  reason       String?
  rejectedById String        @map("rejected_by_id") @db.Uuid
  rejectedBy   User          @relation(fields: [rejectedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([kind])
  @@index([createdAt])
  @@map("rejection_logs")
}
